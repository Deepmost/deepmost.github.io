{
  "name": "prisma-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:work-summary": "node scripts/generate-work-summary.mjs",
    "externalize:static-scripts": "node scripts/externalize-static-scripts.mjs",
    "sanitize:ragent-doc": "node scripts/sanitize-ragent-doc.mjs",
    "build": "npm run generate:work-summary && npm run externalize:static-scripts && npm run sanitize:ragent-doc && tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "framer-motion": "11.18.2",
    "highlight.js": "^11.11.1",
    "lucide-react": "0.469.0",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.12.0",
    "react": "18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "6.0.7"
  }
}
